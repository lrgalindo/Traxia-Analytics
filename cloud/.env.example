# ── Traxia Cloud API — environment variables ─────────────────────────────────
# Copy this file to:
#   secrets/dev.env.local     — local dev (see docs/design-workflow.md)
#   Render Dashboard > Environment — production
# Never commit files with real values.

# ── Database ──────────────────────────────────────────────────────────────────
# DEV:  postgresql://postgres:postgres@127.0.0.1:5433/traxia
#       (Docker e2e postgres; start with: docker-compose -f docker-compose.e2e.yml up -d postgres)
# PROD: postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/traxia

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate prod value: python3 -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=replace-with-a-long-random-string

# Fernet key: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RTSP_ENCRYPTION_KEY=replace-with-fernet-key

# SuperAdmin JWT secret — intentionally separate from JWT_SECRET
PLATFORM_ADMIN_SECRET=replace-with-a-long-random-string

# ── Supabase Auth (required for MFA / user sign-in) ──────────────────────────
# Find in: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...

# ── Cloudflare R2 (snapshot storage) ─────────────────────────────────────────
R2_ACCOUNT_ID=replace
R2_ACCESS_KEY_ID=replace
R2_SECRET_ACCESS_KEY=replace
R2_BUCKET_SNAPSHOTS=traxia-analytics
S3_API=https://<account-id>.r2.cloudflarestorage.com/<bucket>

# ── AI (Copilot) ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional / advanced ───────────────────────────────────────────────────────
# How long the previous refresh token hash stays valid after rotation (seconds)
REFRESH_GRACE_SECONDS=90
